{
  "name": "@arnessa/agui-chat-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.52",
    "@ag-ui/core": "0.0.52",
    "clsx": "^2.1.1",
    "lucide-react": "^0.300.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "7.8.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-plugin-react": "^7.37.5",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.2",
    "vitest": "^1.2.0"
  }
}
